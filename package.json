{
  "name": "roadster-c-magnet-ramp",
  "version": "1.2.0",
  "description": "Tesla Roadster @ Texas SpaceX test site — C-magnet ramp inverted-hold animation (Three.js + SVG)",
  "type": "module",
  "scripts": {
    "deps": "./fetch-deps.sh",
    "serve": "python3 -m http.server 8000 --directory outputs",
    "test": "node tests/kinematics.test.mjs && node tests/geometry.test.mjs && node tests/particles.test.mjs && node tests/frame-check.mjs",
    "test:kinematics": "node tests/kinematics.test.mjs",
    "test:geometry": "node tests/geometry.test.mjs",
    "test:particles": "node tests/particles.test.mjs",
    "test:frames": "node tests/frame-check.mjs",
    "test:browser": "python3 tests/browser.test.py",
    "test:all": "npm test && npm run test:visual",
    "test:nozzles": "node tests/nozzles.test.mjs",
    "test:visual": "node tests/run-visual.mjs",
    "test:visual:gallery": "node tests/gallery-shots.mjs",
    "test:visual:frames": "node tests/visual-reference.mjs",
    "test:visual:compare": "node tests/side-by-side.mjs",
    "test:visual:nozzles": "node tests/nozzle-timeline.mjs",
    "demo": "node tests/demo-shots.mjs",
    "test:visual:demo": "node tests/demo-shots.mjs"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "playwright": "^1.40.0"
  }
}
